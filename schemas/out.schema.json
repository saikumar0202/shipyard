{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "out.json, written by the agent job's non-AI finalize step and read only by the post job. See docs/OUT_JSON.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role", "agent", "issue", "exit_reason", "duration_seconds",
               "comment", "labels_add", "labels_remove", "has_patch", "permission_denials"],
  "properties": {
    "schema_version":   {"const": 1},
    "role":             {"enum": ["planner", "reproducer", "builder", "reviewer"]},
    "agent":            {"type": "string"},
    "review_name":      {"type": ["string", "null"]},
    "issue":            {"type": "integer"},
    "pr":               {"type": ["integer", "null"]},
    "exit_reason":      {"enum": ["success", "max_turns", "usage_limit", "cli_error", "bad_output", "empty_patch", "tampered", "timeout_or_crash"]},
    "duration_seconds": {"type": "integer"},
    "num_turns":        {"type": ["integer", "null"]},
    "comment":          {"type": "string"},
    "labels_add":       {"type": "array", "items": {"type": "string"}},
    "labels_remove":    {"type": "array", "items": {"type": "string"}},
    "check":            {"type": ["object", "null"]},
    "summary_title":    {"type": "string"},
    "pr_title":         {"type": "string"},
    "pr_body":          {"type": "string"},
    "has_patch":        {"type": "boolean"},
    "permission_denials": {"type": "array", "items": {"type": "object", "properties": {"tool": {"type": ["string", "null"]}, "input": {"type": "string"}}}},
    "git_tamper": {
      "type": ["object", "null"],
      "properties": {
        "hooks": {"type": "array", "items": {"type": "string"}},
        "config_changed": {"type": "boolean"},
        "base_is_ancestor": {"type": "boolean"},
        "protected_paths_touched": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
